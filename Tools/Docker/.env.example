# Zugangsdaten für das Produktions-Deployment (docker-compose.prod.yml).
# Nach "Tools/Docker/.env" kopieren und ALLE Werte durch eigene, zufällige
# Werte ersetzen (z. B. mit: openssl rand -base64 48).
# Die .env-Datei ist per .gitignore vom Commit ausgeschlossen.

# MariaDB
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# MinIO (Objektspeicher für Bilder). Secret mind. 8 Zeichen.
MINIO_ACCESS_KEY=spukhaus
MINIO_SECRET_KEY=change-me-min-8-chars

# Signaturschlüssel für Login-Tokens, mind. 32 Zeichen.
JWT_SECRET=change-me-to-a-long-random-string-with-at-least-32-chars

# Erster TechAdmin – wird nur beim allerersten Start angelegt, solange noch
# keine Benutzer existieren. Nach dem ersten Login Passwort ändern.
BOOTSTRAP_TECH_ADMIN_USERNAME=techadmin
BOOTSTRAP_TECH_ADMIN_PASSWORD=change-me
